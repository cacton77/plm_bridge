<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plm_bridge</name>
  <version>0.1.0</version>
  <description>Local parts catalog over PLM systems (3DEXPERIENCE first): sync, STEP cache, plan and result upload, browser part picker. No ROS imports.</description>
  <maintainer email="actonc@uw.edu">Colin Acton</maintainer>
  <license>TODO: license to be confirmed</license>

  <exec_depend>cad_loader</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
