<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plm_bridge_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 node and launch file for plm_bridge: catalog services, part selection, the picker.</description>
  <maintainer email="actonc@uw.edu">Colin Acton</maintainer>
  <license>TODO: license to be confirmed</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>plm_bridge</exec_depend>
  <exec_depend>plm_interfaces</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
